aws_region                  = "eu-west-2"
project_name                = "production-eks-platform"
environment                 = "dev"
vpc_cidr                    = "10.20.0.0/16"
enable_nat_gateway          = false
ecr_untagged_retention_days = 7
ecr_tagged_image_count      = 20
monthly_budget_limit_usd    = 75
budget_alert_email          = "replace-with-your-email@example.com"

public_subnets = {
  "eu-west-2a" = "10.20.0.0/24"
  "eu-west-2b" = "10.20.1.0/24"
}

private_subnets = {
  "eu-west-2a" = "10.20.10.0/24"
  "eu-west-2b" = "10.20.11.0/24"
}